<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net48</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <RootNamespace>Server</RootNamespace>
    <GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)'=='Debug'">
    <DefineConstants>DEBUG;TRACE</DefineConstants>
  </PropertyGroup>

  <PropertyGroup>
    <DefineConstants>NEWTIMERS</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <Optimize>False</Optimize>
    <!-- Portable PDB (managed) instead of 'full' (Windows native). The native PDB writer has
         a 65504-byte per-method debug-metadata ceiling; large methods (e.g. Farms.PlantGardens)
         exceed it and fail with CS0041. Portable PDB has no such limit and still supports
         breakpoints in Visual Studio. Must match the /debug:portable used by runtime ScriptCompiler. -->
    <DebugType>portable</DebugType>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <DebugType>portable</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Info\Scripts\SettingsOnly.csproj" />
    <ProjectReference Include="..\System\System.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="mscorlib" />
    <Reference Include="System" />
    <Reference Include="System.Core" />
    <Reference Include="System.Web" />
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Windows.Forms" />
  </ItemGroup>

  <ItemGroup>
    <!-- Runtime compilation (ScriptCompiler) merges Info/Scripts + Source/Scripts into one
         assembly, so StoreMerchant (Info/Scripts/Merchant.cs) and its base SBInfo
         (Mobiles/Base/BaseVendor.cs) are mutually visible at runtime. Mirror that here for
         the IDE: Merchant.cs is consumed by Scripts/Mobiles/.../Merchant.cs and depends on
         Scripts types (SBInfo, GenericBuyInfo), so it belongs in this project, not
         SettingsOnly (which would create a circular dependency). Settings.override.cs is
         intentionally excluded — it is owned by Configurable.csproj. -->
    <Compile Include="..\..\Info\Scripts\Merchant.cs">
      <Link>Info\Scripts\Merchant.cs</Link>
    </Compile>
  </ItemGroup>
</Project>